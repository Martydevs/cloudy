# Neon Postgres (conexión pooled de la rama)
NUXT_DATABASE_URL=

# Neon Auth de la rama (Branch → Auth → Configuration). Secreto: openssl rand -base64 32
NUXT_NEON_AUTH_BASE_URL=
NUXT_NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible) de la rama
NUXT_AWS_ENDPOINT_URL_S3=
NUXT_AWS_ACCESS_KEY_ID=
NUXT_AWS_SECRET_ACCESS_KEY=
NUXT_AWS_REGION=
NUXT_S3_BUCKET=

# Origen público de la app (CORS del bucket, enlaces y recuperación de contraseña)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron de Vercel y sal para el hash de IPs
CRON_SECRET=
NUXT_RATE_LIMIT_SALT=
