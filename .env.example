NUXT_NEON_AUTH_COOKIE_SECRET=

# IA de lectura de imágenes: OpenRouter, único proveedor (preset `@preset/image-content-extraction`).
NUXT_OPENROUTER_APIKEY=""
# Vacío = OpenRouter real; solo los e2e lo apuntan a su stub local.
NUXT_OPENROUTER_BASE_URL=""

NUXT_APIFY_API_KEY=""
# Vacío = Apify real; solo los e2e lo apuntan a su stub local (test/e2e/setup/apify-stub.ts).
NUXT_APIFY_BASE_URL=""

NUXT_AWS_ENDPOINT_URL_S3=
NUXT_AWS_ACCESS_KEY_ID=
NUXT_AWS_SECRET_ACCESS_KEY=
NUXT_AWS_REGION=
NUXT_S3_BUCKET=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

CRON_SECRET=
NUXT_RATE_LIMIT_SALT=

# Opcional, solo para `storage:setup*`: orígenes extra para el CORS del bucket, separados por comas
# (p. ej. el alias estable de vista previa en Vercel). También puede darse en la línea de comandos.
CORS_EXTRA_ORIGINS=
