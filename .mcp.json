{
  "mcpServers": {
    "Neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "regle": {
      "command": "npx",
      "args": [
        "-y",
        "@regle/mcp-server"
      ]
    },
    "schedule-x": {
      "command": "npx",
      "args": [
        "-y",
        "@schedule-x/mcp"
      ]
    },
    "apify-webcrawler": {
      "command": "npx",
      "args": [
        "-y",
        "@apify/actors-mcp-server",
        "--tools",
        "apify/rag-web-browser"
      ]
    }
  }
}