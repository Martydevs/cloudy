{
  "name": "skykids-produccion-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.development",
    "generate": "nuxt generate",
    "preview": "nuxt preview --dotenv .env",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --project unit --project nuxt --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "vitest --project e2e",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "APP_ENV=test drizzle-kit migrate",
    "storage:setup": "bun scripts/storage-setup.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "db:migrate:prod": "APP_ENV=production drizzle-kit migrate",
    "storage:setup:test": "APP_ENV=test bun scripts/storage-setup.ts",
    "storage:setup:prod": "APP_ENV=production bun scripts/storage-setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/nuxt": "15.0.0",
    "daisyui": "^5.7.50",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.144",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
